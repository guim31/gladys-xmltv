{
  "manifest_version": 1,
  "type": "device",
  "name": "XMLTV TV guide",
  "description": {
    "en": "What is on now, next and tonight on your TV channels, from any XMLTV guide.",
    "fr": "Ce qui passe maintenant, ensuite et ce soir sur vos chaînes, depuis tout guide XMLTV.",
    "de": "Was jetzt, danach und heute Abend auf deinen Sendern läuft, aus jedem XMLTV-Guide.",
    "es": "Lo que se emite ahora, después y esta noche en sus cadenas, desde cualquier guía XMLTV."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-xmltv:1.0.0",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-xmltv/main/cover.png",
  "categories": ["multimedia"],
  "transports": ["local"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "How it works",
        "fr": "Fonctionnement",
        "de": "So funktioniert es",
        "es": "Funcionamiento"
      },
      "description": {
        "en": "Enter the address of an XMLTV guide (.xml or .xml.gz), then the channels you follow. Press \"Test the guide\", and add the channels from the Discovery tab. The guide is downloaded at most every 6 hours.",
        "fr": "Indiquez l'adresse d'un guide XMLTV (.xml ou .xml.gz), puis les chaînes suivies. Appuyez sur « Tester le guide » et ajoutez les chaînes depuis l'onglet Découverte. Le guide est téléchargé au plus toutes les 6 heures.",
        "de": "Gib die Adresse eines XMLTV-Guides (.xml oder .xml.gz) und die verfolgten Sender ein. Drücke „Programmführer testen“ und füge die Sender über den Tab „Entdecken“ hinzu. Der Guide wird höchstens alle 6 Stunden geladen.",
        "es": "Indique la dirección de una guía XMLTV (.xml o .xml.gz) y las cadenas que sigue. Pulse «Probar la guía» y añada las cadenas desde la pestaña Descubrimiento. La guía se descarga como máximo cada 6 horas."
      },
      "links": [
        {
          "url": "https://xmltvfr.fr",
          "label": {
            "en": "XMLTV guides for France",
            "fr": "Guides XMLTV France",
            "de": "XMLTV-Guides Frankreich",
            "es": "Guías XMLTV de Francia"
          }
        },
        {
          "url": "https://github.com/iptv-org/epg",
          "label": {
            "en": "Guides of other countries",
            "fr": "Guides d'autres pays",
            "de": "Guides anderer Länder",
            "es": "Guías de otros países"
          }
        },
        {
          "url": "https://github.com/guim31/gladys-xmltv#readme",
          "label": {
            "en": "Documentation",
            "fr": "Documentation",
            "de": "Dokumentation",
            "es": "Documentación"
          }
        }
      ]
    },
    {
      "key": "guide_url",
      "type": "string",
      "label": {
        "en": "Guide address",
        "fr": "Adresse du guide",
        "de": "Adresse des Programmführers",
        "es": "Dirección de la guía"
      },
      "description": {
        "en": "An https:// or http:// address, or a file of the data volume (/data/guide.xml.gz).",
        "fr": "Une adresse https:// ou http://, ou un fichier du volume de données (/data/guide.xml.gz).",
        "de": "Eine Adresse mit https:// oder http:// oder eine Datei im Datenvolume (/data/guide.xml.gz).",
        "es": "Una dirección https:// o http://, o un archivo del volumen de datos (/data/guide.xml.gz)."
      },
      "placeholder": {
        "en": "e.g. https://xmltvfr.fr/xmltv/xmltv_tnt.xml.gz",
        "fr": "ex. https://xmltvfr.fr/xmltv/xmltv_tnt.xml.gz",
        "de": "z. B. https://xmltvfr.fr/xmltv/xmltv_tnt.xml.gz",
        "es": "p. ej. https://xmltvfr.fr/xmltv/xmltv_tnt.xml.gz"
      },
      "required": true,
      "default": ""
    },
    {
      "key": "channels",
      "type": "string",
      "label": {
        "en": "Followed channels",
        "fr": "Chaînes suivies",
        "de": "Verfolgte Sender",
        "es": "Cadenas seguidas"
      },
      "description": {
        "en": "Channel ids or names of the guide, separated by commas, 20 at most. \"List the channels\" shows them.",
        "fr": "Identifiants ou noms des chaînes du guide, séparés par des virgules, 20 au plus. « Lister les chaînes » les affiche.",
        "de": "IDs oder Namen der Sender im Guide, durch Kommas getrennt, höchstens 20. „Sender auflisten“ zeigt sie an.",
        "es": "Identificadores o nombres de las cadenas de la guía, separados por comas, 20 como máximo. «Listar las cadenas» los muestra."
      },
      "placeholder": {
        "en": "e.g. TF1.fr, France 2, Arte",
        "fr": "ex. TF1.fr, France 2, Arte",
        "de": "z. B. TF1.fr, France 2, Arte",
        "es": "p. ej. TF1.fr, France 2, Arte"
      },
      "required": true,
      "default": ""
    },
    {
      "key": "evening_time",
      "type": "select",
      "label": {
        "en": "Evening start",
        "fr": "Début de soirée",
        "de": "Beginn des Abendprogramms",
        "es": "Inicio de la noche"
