            "de": "Deutsch",
            "es": "Alemán"
          }
        },
        {
          "value": "es",
          "label": {
            "en": "Spanish",
            "fr": "Espagnol",
            "de": "Spanisch",
            "es": "Español"
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "test_guide",
      "label": {
        "en": "Test the guide",
        "fr": "Tester le guide",
        "de": "Programmführer testen",
        "es": "Probar la guía"
      },
      "description": {
        "en": "Downloads the guide now and says which followed channels it holds.",
        "fr": "Télécharge le guide maintenant et dit quelles chaînes suivies il contient.",
        "de": "Lädt den Programmführer jetzt und sagt, welche verfolgten Sender er enthält.",
        "es": "Descarga la guía ahora e indica qué cadenas seguidas contiene."
      },
      "timeout_seconds": 120
    },
    {
      "key": "list_channels",
      "label": {
        "en": "List the channels",
        "fr": "Lister les chaînes",
        "de": "Sender auflisten",
        "es": "Listar las cadenas"
      },
      "description": {
        "en": "The channels of the last guide read, with their ids, 60 at most.",
        "fr": "Les chaînes du dernier guide lu, avec leurs identifiants, 60 au plus.",
        "de": "Die Sender des zuletzt gelesenen Guides mit ihren IDs, höchstens 60.",
        "es": "Las cadenas de la última guía leída, con sus identificadores, 60 como máximo."
      },
      "timeout_seconds": 10,
      "fields": [
        {
          "key": "filter",
          "type": "string",
          "label": {
            "en": "Search",
            "fr": "Recherche",
            "de": "Suche",
            "es": "Búsqueda"
          },
          "placeholder": {
            "en": "e.g. BBC",
            "fr": "ex. France",
            "de": "z. B. ARD",
            "es": "p. ej. TVE"
          },
          "required": false
        }
      ]
    }
  ],
  "scene_triggers": [
    {
      "key": "keyword_programme",
      "label": {
        "en": "Programme with a keyword",
        "fr": "Programme avec un mot-clé",
        "de": "Sendung mit Stichwort",
        "es": "Programa con una palabra clave"
      },
      "description": {
        "en": "A programme whose title holds one of the configured keywords starts, or is about to.",
        "fr": "Un programme dont le titre contient un des mots-clés configurés commence, ou va commencer.",
        "de": "Eine Sendung, deren Titel ein konfiguriertes Stichwort enthält, beginnt oder beginnt gleich.",
        "es": "Un programa cuyo título contiene una de las palabras clave configuradas empieza o va a empezar."
      },
      "fields": [
        {
          "key": "keyword",
          "type": "string",
          "label": {
            "en": "Keyword",
            "fr": "Mot-clé",
            "de": "Stichwort",
            "es": "Palabra clave"
          },
          "description": {
            "en": "As written in the configuration. Empty: every keyword.",
            "fr": "Tel qu'écrit dans la configuration. Vide : tous les mots-clés.",
            "de": "Wie in der Konfiguration geschrieben. Leer: alle Stichwörter.",
            "es": "Tal como está escrita en la configuración. Vacío: todas."
          },
          "placeholder": {
            "en": "e.g. Top 14",
            "fr": "ex. Top 14",
            "de": "z. B. Tatort",
            "es": "p. ej. LaLiga"
          }
        },
        {
          "key": "channel",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Channel",
            "fr": "Chaîne",
            "de": "Sender",
            "es": "Cadena"
          },
          "description": {
            "en": "Empty: every followed channel.",
            "fr": "Vide : toutes les chaînes suivies.",
            "de": "Leer: alle verfolgten Sender.",
            "es": "Vacío: todas las cadenas seguidas."
          },
          "required": false
        },
        {
          "key": "moment",
          "type": "select",
          "label": {
            "en": "When",
            "fr": "Quand",
            "de": "Wann",
            "es": "Cuándo"
          },
          "required": true,
          "default": "start",
          "options": [
            {
              "value": "start",
              "label": {
                "en": "At the start",
                "fr": "Au début",
                "de": "Zum Beginn",
                "es": "Al inicio"
              }
            },
            {
              "value": "before",
              "label": {
                "en": "Before the start (advance warning)",
                "fr": "Avant le début (prévenir en avance)",
                "de": "Vor dem Beginn (Vorwarnung)",
                "es": "Antes del inicio (aviso anticipado)"
              }
            }
          ]
        }
      ],
      "variables": [
        {
          "key": "keyword",
          "type": "string",
          "label": {
            "en": "Keyword",
            "fr": "Mot-clé",
            "de": "Stichwort",
            "es": "Palabra clave"
          }
        },
        {
          "key": "channel_name",
          "type": "string",
          "label": {
            "en": "Channel",
            "fr": "Chaîne",
            "de": "Sender",
            "es": "Cadena"
          }
        },
        {
          "key": "title",
          "type": "string",
          "label": {
            "en": "Title",
            "fr": "Titre",
            "de": "Titel",
            "es": "Título"
          }
        },
        {
          "key": "subtitle",
          "type": "string",
          "label": {
            "en": "Subtitle (episode)",
            "fr": "Sous-titre (épisode)",
            "de": "Untertitel (Folge)",
            "es": "Subtítulo (episodio)"
          }
        },
        {
          "key": "category",
          "type": "string",
          "label": {
            "en": "Category",
            "fr": "Catégorie",
            "de": "Kategorie",
            "es": "Categoría"
          }
        },
        {
          "key": "start",
          "type": "string",
          "label": {
            "en": "Start time",
            "fr": "Heure de début",
            "de": "Beginn",
            "es": "Hora de inicio"
          }
        },
        {
          "key": "end",
          "type": "string",
          "label": {
            "en": "End time",
            "fr": "Heure de fin",
            "de": "Ende",
            "es": "Hora de fin"
          }
        },
        {
          "key": "duration",
          "type": "number",
          "label": {
            "en": "Duration (minutes)",
            "fr": "Durée (minutes)",
            "de": "Dauer (Minuten)",
            "es": "Duración (minutos)"
          }
        }
      ]
    }
  ],
  "scene_actions": [
    {
      "key": "whats_on",
      "label": {
        "en": "Read a channel's programme",
        "fr": "Lire le programme d'une chaîne",
        "de": "Programm eines Senders lesen",
        "es": "Leer el programa de una cadena"
      },
      "description": {
        "en": "What is on a followed channel now, next or tonight.",
        "fr": "Ce qui passe sur une chaîne suivie maintenant, ensuite ou ce soir.",
        "de": "Was auf einem verfolgten Sender jetzt, danach oder heute Abend läuft.",
        "es": "Lo que se emite en una cadena seguida ahora, después o esta noche."
      },
      "timeout_seconds": 10,
      "fields": [
        {
          "key": "channel",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Channel",
            "fr": "Chaîne",
            "de": "Sender",
            "es": "Cadena"
          },
          "required": true
        },
        {
          "key": "moment",
          "type": "select",
          "label": {
            "en": "When",
            "fr": "Quand",
            "de": "Wann",
            "es": "Cuándo"
          },
          "required": true,
          "options": [
            {
              "value": "now",
              "label": {
                "en": "Now",
                "fr": "En ce moment",
                "de": "Jetzt",
                "es": "Ahora"
              }
            },
            {
              "value": "next",
              "label": {
                "en": "Next",
                "fr": "Ensuite",
                "de": "Danach",
                "es": "A continuación"
              }
            },
            {
              "value": "tonight",
              "label": {
                "en": "Tonight",
                "fr": "Ce soir",
                "de": "Heute Abend",
                "es": "Esta noche"
              }
            }
          ]
        }
      ],
      "outputs": [
        {
          "key": "found",
          "type": "number",
          "label": {
            "en": "Found (1) or not (0)",
            "fr": "Trouvé (1) ou non (0)",
            "de": "Gefunden (1) oder nicht (0)",
            "es": "Encontrado (1) o no (0)"
          }
        },
        {
          "key": "channel",
          "type": "string",
          "label": {
            "en": "Channel",
            "fr": "Chaîne",
            "de": "Sender",
            "es": "Cadena"
          }
        },
        {
          "key": "title",
          "type": "string",
          "label": {
            "en": "Title",
            "fr": "Titre",
            "de": "Titel",
            "es": "Título"
          }
        },
        {
          "key": "subtitle",
          "type": "string",
          "label": {
            "en": "Subtitle (episode)",
            "fr": "Sous-titre (épisode)",
            "de": "Untertitel (Folge)",
            "es": "Subtítulo (episodio)"
          }
        },
        {
          "key": "category",
          "type": "string",
          "label": {
            "en": "Category",
            "fr": "Catégorie",
            "de": "Kategorie",
            "es": "Categoría"
          }
