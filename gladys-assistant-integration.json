            "de": "22:30",
            "es": "22:30"
          }
        }
      ]
    },
    {
      "key": "refresh_hours",
      "type": "select",
      "label": {
        "en": "Download the guide",
        "fr": "Télécharger le guide",
        "de": "Programmführer laden",
        "es": "Descargar la guía"
      },
      "required": false,
      "default": "12",
      "options": [
        {
          "value": "6",
          "label": {
            "en": "Every 6 hours",
            "fr": "Toutes les 6 heures",
            "de": "Alle 6 Stunden",
            "es": "Cada 6 horas"
          }
        },
        {
          "value": "12",
          "label": {
            "en": "Every 12 hours",
            "fr": "Toutes les 12 heures",
            "de": "Alle 12 Stunden",
            "es": "Cada 12 horas"
          }
        },
        {
          "value": "24",
          "label": {
            "en": "Once a day",
            "fr": "Une fois par jour",
            "de": "Einmal am Tag",
            "es": "Una vez al día"
          }
        }
      ]
    },
    {
      "key": "keywords",
      "type": "string",
      "label": {
        "en": "Keywords for the scenes",
        "fr": "Mots-clés pour les scènes",
        "de": "Stichwörter für Szenen",
        "es": "Palabras clave para las escenas"
      },
      "description": {
        "en": "Titles to watch for on the followed channels, separated by commas. Their start fires the \"Programme with a keyword\" trigger.",
        "fr": "Titres à guetter sur les chaînes suivies, séparés par des virgules. Leur début déclenche « Programme avec un mot-clé ».",
        "de": "Titel, auf die du bei den verfolgten Sendern achten willst, durch Kommas getrennt. Der Beginn einer solchen Sendung löst „Sendung mit Stichwort“ aus.",
        "es": "Títulos que vigilar en las cadenas seguidas, separados por comas. Su inicio activa «Programa con una palabra clave»."
      },
      "placeholder": {
        "en": "e.g. Top 14, Koh-Lanta",
        "fr": "ex. Top 14, Koh-Lanta",
        "de": "z. B. Tatort, Champions League",
        "es": "p. ej. LaLiga, MasterChef"
      },
      "required": false,
      "default": ""
    },
    {
      "key": "advance_minutes",
      "type": "select",
      "label": {
        "en": "Advance warning",
        "fr": "Prévenir en avance",
        "de": "Vorwarnung",
        "es": "Aviso anticipado"
      },
      "description": {
        "en": "The trigger can also fire this many minutes before the start.",
        "fr": "Le déclencheur peut aussi partir autant de minutes avant le début.",
        "de": "Der Auslöser kann auch so viele Minuten vor dem Beginn auslösen.",
        "es": "El disparador también puede activarse tantos minutos antes del inicio."
      },
      "required": false,
      "default": "5",
      "options": [
        {
          "value": "0",
          "label": {
            "en": "No",
            "fr": "Non",
            "de": "Nein",
            "es": "No"
          }
        },
        {
          "value": "5",
          "label": {
            "en": "5 minutes before",
            "fr": "5 minutes avant",
            "de": "5 Minuten vorher",
            "es": "5 minutos antes"
          }
        },
        {
          "value": "10",
          "label": {
            "en": "10 minutes before",
            "fr": "10 minutes avant",
            "de": "10 Minuten vorher",
            "es": "10 minutos antes"
          }
        },
        {
          "value": "15",
          "label": {
            "en": "15 minutes before",
            "fr": "15 minutes avant",
            "de": "15 Minuten vorher",
            "es": "15 minutos antes"
          }
        },
        {
          "value": "30",
          "label": {
            "en": "30 minutes before",
            "fr": "30 minutes avant",
            "de": "30 Minuten vorher",
            "es": "30 minutos antes"
          }
        }
      ]
    },
    {
      "key": "language",
      "type": "select",
      "label": {
        "en": "Language of the texts",
        "fr": "Langue des textes",
        "de": "Sprache der Texte",
        "es": "Idioma de los textos"
      },
      "description": {
        "en": "Feature names, published texts and scene outputs. The widget follows the dashboard.",
        "fr": "Noms des fonctionnalités, textes publiés et sorties des scènes. Le widget suit le tableau de bord.",
        "de": "Namen der Funktionen, veröffentlichte Texte und Szenenausgaben. Das Widget folgt dem Dashboard.",
        "es": "Nombres de las funciones, textos publicados y salidas de las escenas. El widget sigue el panel."
      },
      "required": false,
      "default": "fr",
      "options": [
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais",
            "de": "Englisch",
            "es": "Inglés"
          }
        },
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français",
